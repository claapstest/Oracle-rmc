# Server Port
PORT=5000

# Execution Mode: DEMO or ORACLE_FUSION
ENVIRONMENT_MODE=DEMO

# Groq NLU API Key (Optional: fallbacks to keyword parser if missing)
GROQ_API_KEY=
# Upgraded/configured Groq model (e.g. openai/gpt-oss-20b, mixtral-8x7b-32768, etc.)
GROQ_MODEL=openai/gpt-oss-20b

# Live Oracle Fusion REST APIs Endpoint Configurations
ORACLE_FUSION_BASE_URL=
ORACLE_AUTH_TYPE=BASIC
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TOKEN=

# Oracle Fusion BI Publisher Credentials (Optional overrides; falls back to ORACLE_* above)
FUSION_HOST=
FUSION_USERNAME=
FUSION_PASSWORD=

# VEYRA PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=veyra_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/veyra_db

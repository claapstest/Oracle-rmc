# Server Port
PORT=5000

# Execution Mode: DEMO or ORACLE_FUSION
ENVIRONMENT_MODE=DEMO

# Authentication Provider: LOCAL or ENTRA
AUTH_PROVIDER=LOCAL

# Microsoft Entra ID (OIDC Authorization Code + PKCE)
# ENTRA_REDIRECT_URI must exactly match the redirect URI registered for the app.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=http://localhost:5173/
# Optional: only for a confidential BFF client. Never expose this to the frontend.
ENTRA_CLIENT_SECRET=
# Entra User Provisioning & Identity Mapping (Story 12 - VYR-012)
ENTRA_JIT_PROVISIONING=true
ENTRA_DEFAULT_ROLE=AUDIT_USER
# Entra Role & Privilege Mapping (Story 13 - VYR-013)
# JSON or comma-separated pairs: Entra App Role / Group OID -> Veyra role
# e.g. {"Veyra.SiteAdmin":"SITE_ADMIN","Veyra.AuditManager":"AUDIT_MANAGER"}
ENTRA_ROLE_MAPPING=
# When true, Entra users without an approved mapped role are denied with 403 ROLE_NOT_MAPPED
ENTRA_REQUIRE_ROLE_MAPPING=false

# Live Oracle Fusion REST APIs Endpoint Configurations
ORACLE_FUSION_BASE_URL=
ORACLE_AUTH_TYPE=BASIC
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TOKEN=

# Oracle Fusion BI Publisher Credentials (Optional overrides; falls back to ORACLE_* above)
FUSION_HOST=
FUSION_USERNAME=
FUSION_PASSWORD=

# VEYRA PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=veyra_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/veyra_db

# Server Port
PORT=5000

# Execution Mode: DEMO or ORACLE_FUSION
ENVIRONMENT_MODE=DEMO

# Together AI API Key (Paid Cloud LLM Engine for Ask Veyra & Text-to-SQL)
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b
LLM_ENDPOINT=https://api.together.xyz/v1/chat/completions

# Compatibility aliases
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Live Oracle Fusion REST APIs Endpoint Configurations
ORACLE_FUSION_BASE_URL=
ORACLE_AUTH_TYPE=BASIC
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_TOKEN=

# Oracle Fusion BI Publisher Credentials (Optional overrides; falls back to ORACLE_* above)
FUSION_HOST=
FUSION_USERNAME=
FUSION_PASSWORD=

# VEYRA PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=veyra_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/veyra_db
